rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDoctor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Doctor";
    }

    // USERS COLLECTION
    match /users/{userId} {
      // User can read their own profile, or doctors can read patient profiles to populate patient directory
      allow read: if isOwner(userId) || isDoctor();

      // User can create their own account document during registration
      allow create: if isOwner(userId);

      // User can update their own profile (name, etc.) but cannot modify role
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));

      allow delete: if false;
    }

    // MEDICAL RECORDS COLLECTION
    match /medical_records/{recordId} {
      // Patients can only read their own medical records; doctors can read all records
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) || isDoctor();

      // Only doctors can create, update, or delete medical records
      allow create, update, delete: if isDoctor();
    }

    // APPOINTMENTS COLLECTION
    match /appointments/{appointmentId} {
      // Patients can read their own appointments; doctors can read all appointments
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) || isDoctor();

      // Doctors can schedule and manage appointments
      allow create, delete: if isDoctor();

      // Both doctors and the owning patient can update appointment status (e.g. Cancel)
      allow update: if isDoctor() || (isAuthenticated() && resource.data.patientId == request.auth.uid);
    }

    // PRESCRIPTIONS COLLECTION
    match /prescriptions/{prescriptionId} {
      // Patients can read only their own prescriptions; doctors can read all
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) || isDoctor();

      // Only doctors can issue, modify, or delete prescriptions
      allow create, update, delete: if isDoctor();
    }

    // LAB REPORTS COLLECTION
    match /lab_reports/{reportId} {
      // Patients can read only their own lab reports; doctors can read all
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) || isDoctor();

      // Only doctors / lab staff can create, update, or delete lab reports
      allow create, update, delete: if isDoctor();
    }

    // MEDICAL HISTORY COLLECTION
    match /medical_history/{historyId} {
      // Patients can read only their own history; doctors can read all history
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) || isDoctor();

      // Only doctors can create, update, or delete medical history records
      allow create, update, delete: if isDoctor();
    }
  }
}
